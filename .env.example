# Local development source. The site never commits copied Overcast docs.
OVERCAST_LOCAL_PATH=/path/to/overcast
OVERCAST_BRANDING_PATH=/path/to/branding

# CI/release defaults.
OVERCAST_REPO=Neaox/overcast
OVERCAST_TRACKING_REF=alpha
OVERCAST_SOURCE_REF=alpha
OVERCAST_EDIT_REF=main

# GitHub edit links for website-owned pages.
WEBSITE_REPO=overcast-sh/website
WEBSITE_EDIT_REF=main

# Edit links: auto uses VS Code in `astro dev` and GitHub in production builds.
# Set to github or vscode to force a mode.
EDIT_LINK_MODE=auto
