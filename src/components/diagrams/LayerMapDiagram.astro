---
// /docs/ index diagram: "there's a short path and a deep path." Four numbered stops, each
// one step deeper than the last, with the quickstart as the lit entry point.
//
// Built from HTML rather than a scaled SVG, for the same reason as ArchitectureDiagram: the
// slot is ~585px on desktop and ~310px on a phone, and a fixed viewBox has to shrink to fit
// the narrow case. Here it also buys the layout change that a viewBox cannot — a container
// query folds the four-across track into a 2x2 grid, instead of shrinking the type to fit.
//
// Each stop carries its own ramp slot, the same colour system the service tiles use, so the
// four stops read as four different places rather than four grey boxes. The step numbers
// carry the order once the connectors drop away in the folded layout.
import { GitBranch, Table2, Terminal, Wrench } from "@lucide/astro";

const stops = [
  { step: "01", label: "Quickstart", note: "one command, 2 min", icon: Terminal, tint: "var(--oc-accent)", start: true },
  { step: "02", label: "Task guides", note: "CDK, SDKs, migration", icon: Wrench, tint: "var(--oc-cat-5)", start: false },
  { step: "03", label: "Service reference", note: "per-operation tables", icon: Table2, tint: "var(--oc-cat-2)", start: false },
  { step: "04", label: "Source", note: "GitHub, CONTRIBUTING", icon: GitBranch, tint: "var(--oc-cat-8)", start: false },
];
---

<figure
  class="lmap"
  role="img"
  aria-label="Four stops, each one step deeper: quickstart, task guides, service reference, then source. Start at the first and go on only as far as you need."
>
  <div class="lmap-track">
    {stops.map(({ step, label, note, icon: Icon, tint, start }, i) => (
      <>
        {i > 0 && <span class="lmap-arrow"></span>}
        <span class="lmap-stop" style={`--oc-tint:${tint}`}>
          <span class:list={["lmap-step", start && "is-start"]}>{step}</span>
          <span class:list={["lmap-tile", start && "is-start"]}>
            <Icon class="icon" />
          </span>
          <span class="lmap-label">{label}</span>
          <span class="lmap-note">{note}</span>
        </span>
      </>
    ))}
  </div>
</figure>

<style>
  .lmap {
    container-type: inline-size;
    margin: 0;
    width: 100%;
    font-family: var(--oc-font-mono);
  }

  .lmap-track {
    display: flex;
    align-items: flex-start;
  }

  .lmap-stop {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .lmap-step {
    font-size: var(--oc-text-2xs);
    line-height: 14px;
    letter-spacing: 0.14em;
    color: var(--oc-muted);
  }

  .lmap-step.is-start {
    color: var(--oc-accent);
  }

  /* 36px tile, 10px below the 14px step line — which is what puts the
   * connector's centre at 24 + 18 = 42px from the top of a stop. */
  .lmap-tile {
    display: inline-flex;
    flex: none;
    width: 36px;
    height: 36px;
    margin-top: 10px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: color-mix(in oklab, var(--oc-tint) 12%, var(--oc-card));
    border: 1px solid color-mix(in oklab, var(--oc-tint) 32%, transparent);
    color: var(--oc-tint);
  }

  /* The entry point: the one solid tile, with a soft ring so the eye starts here. */
  .lmap-tile.is-start {
    background: var(--oc-tint);
    border-color: var(--oc-tint);
    color: var(--oc-card);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--oc-tint) 18%, transparent);
  }

  .lmap-tile :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .lmap-label {
    margin-top: 12px;
    font-size: var(--oc-text-2xs);
    font-weight: 700;
    line-height: 1.35;
    color: var(--oc-text);
  }

  .lmap-note {
    margin-top: 2px;
    font-size: var(--oc-text-2xs);
    line-height: 1.45;
    color: var(--oc-muted);
  }

  /* Connector: a hairline across the gutter with a triangle at its head, sitting
   * on the tiles' centre line. */
  .lmap-arrow {
    position: relative;
    flex: none;
    width: 18px;
    height: 2px;
    margin-top: 41px;
    background: var(--oc-line);
  }

  .lmap-arrow::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -1px;
    margin-top: -4px;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--oc-muted);
  }

  /* Too narrow for four across: fold to 2x2 and let the step numbers carry the
   * order, rather than shrinking every label to fit. */
  @container (max-width: 520px) {
    .lmap-track {
      flex-wrap: wrap;
      row-gap: var(--oc-space-5);
    }

    .lmap-stop {
      flex: 1 1 44%;
    }

    .lmap-arrow {
      display: none;
    }
  }
</style>
