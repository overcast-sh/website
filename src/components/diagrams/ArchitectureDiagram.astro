---
// Homepage hero diagram: "one endpoint stands in for AWS." Your app talks to Overcast's
// emulated API, which fans out to the emulated services; the console reads the same
// process on its own port.
//
// Built from HTML and the site's own tokens rather than as a scaled SVG drawing. The slot
// it renders into is ~525px on desktop and ~310px on a phone: a fixed viewBox has to shrink
// to fit the narrow case, which took the old version's labels down to ~6px. Real elements
// keep type at real sizes at every width and let the rows reflow instead of scaling.
//
// Three tiers of type throughout: 15/700 hero title, --oc-text-xs/700 node titles, and the
// scale's floor (--oc-text-2xs) for labels and chips — the floor rather than the 10-11px
// this used to set, which went thin and grey rather than sharp on a high-DPI panel. Three
// depths of surface: --oc-bg for the two ordinary nodes (recessed against the card this
// sits on), --oc-accent-soft for the hero, --oc-card for the chips on top of both.
import ServiceIcon from "../ServiceIcon.astro";

const clients = ["aws cli", "cdk", "sdk"];
const ports = [
  { port: ":4566", role: "emulated AWS API", primary: true },
  { port: ":4567", role: "web console", primary: false },
];
const services = [
  { service: "s3", label: "S3" },
  { service: "lambda", label: "Lambda" },
  { service: "dynamodb", label: "DynamoDB" },
  { service: "sqs", label: "SQS" },
  { service: "sns", label: "SNS" },
];
---

<figure
  class="arch"
  role="img"
  aria-label="Your app, the AWS CLI, CDK, or an SDK point at Overcast's emulated API on port 4566. One Overcast process serves that API and the web console on port 4567, and fans out to the emulated AWS services behind it."
>
  <div class="arch-node">
    <span class="arch-node-title">Your app</span>
    <span class="arch-chip-row">
      {clients.map((client) => <span class="arch-chip">{client}</span>)}
    </span>
  </div>

  <div class="arch-link">
    <span class="arch-link-note">--endpoint-url</span>
  </div>

  <div class="arch-hero">
    <div class="arch-hero-head">
      <span class="arch-mark-tile">
        <img src="/brand/mark-light.svg" alt="" width="22" height="22" class="theme-light-only arch-mark" />
        <img src="/brand/mark-dark.svg" alt="" width="22" height="22" class="theme-dark-only arch-mark" />
      </span>
      <span>
        <span class="arch-hero-title">Overcast</span>
        <span class="arch-hero-note">one process, one endpoint</span>
      </span>
    </div>
    <div class="arch-port-row">
      {ports.map(({ port, role, primary }) => (
        <span class="arch-port">
          <span class:list={["arch-port-num", primary && "is-primary"]}>{port}</span>
          <span class="arch-port-role">{role}</span>
        </span>
      ))}
    </div>
  </div>

  <div class="arch-link"></div>

  <div class="arch-node">
    <span class="arch-node-head">
      <span class="arch-node-title">Services</span>
      <span class="arch-more">50 more &#8594;</span>
    </span>
    <span class="arch-chip-row">
      {services.map(({ service, label }) => (
        <span class="arch-service">
          <ServiceIcon service={service} size="sm" />
          {label}
        </span>
      ))}
    </span>
  </div>
</figure>

<style>
  .arch {
    margin: 0;
    font-family: var(--oc-font-mono);
  }

  /* The two ordinary nodes: recessed a step below the card the figure sits on,
   * so the accent hero between them is the only thing that comes forward. */
  .arch-node {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--oc-space-2) var(--oc-space-4);
    padding: var(--oc-space-3) var(--oc-space-4);
    border: 1px solid var(--oc-line);
    border-radius: var(--oc-radius-card);
    background: var(--oc-bg);
  }

  .arch-node-head {
    display: flex;
    flex: 1 1 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--oc-space-3);
  }

  .arch-node-title {
    font-size: var(--oc-text-xs);
    font-weight: 700;
    color: var(--oc-text);
  }

  .arch-more {
    font-size: var(--oc-text-2xs);
    color: var(--oc-accent);
  }

  .arch-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--oc-space-2);
  }

  .arch-chip {
    padding: 3px 8px;
    border: 1px solid var(--oc-line);
    border-radius: 5px;
    background: var(--oc-card);
    font-size: var(--oc-text-2xs);
    color: var(--oc-muted);
  }

  .arch-service {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px 4px 4px;
    border: 1px solid var(--oc-line);
    border-radius: 7px;
    background: var(--oc-card);
    font-size: var(--oc-text-2xs);
    color: var(--oc-body);
  }

  /* Connector: a 2px rule down the centre line with a triangle at its foot.
   * Drawn from tokens rather than a marker so it stays crisp at any width. */
  .arch-link {
    position: relative;
    height: 30px;
  }

  .arch-link::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 7px;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--oc-accent);
  }

  .arch-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    margin-left: -5px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 8px solid var(--oc-accent);
  }

  .arch-link-note {
    position: absolute;
    top: 50%;
    left: calc(50% + 12px);
    transform: translateY(-50%);
    font-size: var(--oc-text-2xs);
    line-height: 1;
    color: var(--oc-muted);
    white-space: nowrap;
  }

  /* The hero. One soft accent glow, and it is the only shadow in the figure. */
  .arch-hero {
    padding: var(--oc-space-4);
    border: 1px solid var(--oc-accent);
    border-radius: 12px;
    background: var(--oc-accent-soft);
    box-shadow: 0 10px 30px -14px color-mix(in oklab, var(--oc-accent) 65%, transparent);
  }

  .arch-hero-head {
    display: flex;
    align-items: center;
    gap: var(--oc-space-3);
  }

  /* The mark sits on its own card-coloured tile: on the accent panel behind it
   * neither the light nor the dark mark has enough contrast on its own. */
  .arch-mark-tile {
    display: inline-flex;
    flex: none;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: var(--oc-card);
    border: 1px solid color-mix(in oklab, var(--oc-accent) 28%, transparent);
  }

  .arch-mark {
    flex: none;
    width: 22px;
    height: 22px;
  }

  .arch-hero-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--oc-text);
  }

  /* --oc-body, not --oc-muted: this is the one label in the figure that sits on the
   * accent panel rather than a neutral surface, and muted only reaches 4.4:1 there. */
  .arch-hero-note {
    display: block;
    font-size: var(--oc-text-2xs);
    line-height: 1.45;
    color: var(--oc-body);
  }

  .arch-port-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--oc-space-2);
    margin-top: var(--oc-space-3);
  }

  .arch-port {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 5px 10px;
    border: 1px solid var(--oc-line);
    border-radius: var(--oc-radius-control);
    background: var(--oc-card);
  }

  .arch-port-num {
    font-size: var(--oc-text-2xs);
    font-weight: 700;
    color: var(--oc-body);
  }

  .arch-port-num.is-primary {
    color: var(--oc-accent);
  }

  .arch-port-role {
    font-size: var(--oc-text-2xs);
    color: var(--oc-muted);
  }
</style>
