---
import { codeToHtml, type BundledLanguage } from "shiki";

interface Props {
  code: string;
  label?: string;
  language?: BundledLanguage;
}

const { code, label = "terminal", language = "bash" } = Astro.props;
const highlightedCode = await codeToHtml(code, {
  lang: language,
  themes: {
    light: "github-light-default",
    dark: "github-dark-default",
  },
  defaultColor: false,
});
---

<div class="surface overflow-hidden rounded-lg">
  {/* The label truncates rather than pushing the row wider than the phone it is on: at
      a 20px browser default font, ">_ full image with web UI" plus the button ran 65px
      past a 375px viewport and took the whole page into a horizontal scroll. */}
  <div class="flex items-center justify-between gap-2 border-b border-oc px-4 py-2 font-mono text-xs text-muted">
    <span class="min-w-0 truncate">&gt;_ {label}</span>
    {/* "copy" is the same accessible name on every code block a page shows, so the
        label says which one. The click handler is SiteLayout's single delegated
        `[data-copy]` listener — it announces the copy through #copy-status. */}
    <button
      class="copy-button inline-flex min-h-6 items-center rounded px-2 py-1"
      type="button"
      data-copy={code}
      data-copy-label={label}
      aria-label={`Copy ${label}`}
    >
      copy
    </button>
  </div>
  <div class="code-block overflow-x-auto" set:html={highlightedCode}></div>
</div>
