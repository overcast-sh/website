---
// Promotes the site's global search (header-only, icon-sized) as the fast path for "does
// it support X" — pagefind already answers that question directly from a query like
// "transactions"; the gap was that nothing on /docs/ or /support/ pointed at it. Reuses the
// #search-open trigger SiteLayout already wires up rather than duplicating search logic.
import { Search } from "@lucide/astro";

interface Props {
  label?: string;
}

const { label = "Search the docs" } = Astro.props;
---

<button
  type="button"
  data-search-promo
  class="copy-button flex w-full items-center justify-between gap-3 rounded-lg px-5 py-4 font-mono text-sm"
>
  <span class="flex min-w-0 items-center gap-2 text-left">
    <Search class="icon text-accent" />
    <span class="min-w-0">{label}</span>
  </span>
  <kbd class="text-xs text-muted">/</kbd>
</button>
<script>
  // stopPropagation matters here: #search-open's own listener opens the panel
  // synchronously (nested inside this handler), but this button sits outside both
  // the panel and the trigger, so if this click keeps bubbling to <body>'s "click
  // outside the panel" listener, it reads as an outside click and closes the panel
  // it just opened.
  document.querySelectorAll("[data-search-promo]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      document.getElementById("search-open")?.click();
    });
  });
</script>
