---
// Admonition/callout primitive. Use sparingly: only to replace a paragraph of prose that's
// doing "aside" or "warning" duty, never to wrap prose that's already fine as prose.
//
// Kinds, labels and glyphs come from src/lib/callouts.ts and the styling from the
// `.callout` rules in src/styles/global.css — the same pair that renders GitHub `[!NOTE]`
// alerts in synced markdown, so both look identical and theme for free.
import { calloutIconSvg, calloutKinds, type CalloutKind } from "../lib/callouts";

interface Props {
  kind?: CalloutKind;
  title?: string;
}

const { kind = "note", title } = Astro.props;
---

<div class="callout" data-callout={kind}>
  <Fragment set:html={calloutIconSvg(kind)} />
  <div class="callout-body">
    <p class="callout-label">{title ?? calloutKinds[kind].label}</p>
    <slot />
  </div>
</div>
