---
// The docs sidebar. Rendered twice per page — once inside the mobile <details> drawer,
// once in the desktop column — so it lives here rather than being written out twice.
// Only one of the two is ever displayed (the other is `display: none` at that width),
// so the duplicate ids and the shared nav label never both reach the accessibility
// tree; `idPrefix` still differs between them so the document is valid either way.
//
// The section labels used to be <h2>s. On a service page that put nine level-two
// headings ahead of the page's own <h1>, so anyone navigating by heading walked the
// whole sidebar before reaching the title. They are plain text now, and each list is
// named by them through aria-labelledby instead — which is what a set of links wants
// anyway.
//
// Service Reference is the section with structure: ~50 services, each grouped by coverage
// tier, and each optionally holding sub-pages (operations, limitations, ...). Sub-pages
// are only listed under the service you're currently reading, which is what keeps a
// 50-service list from turning into a 250-link list.
//
// A handful of guides (docs/networking, docs/cli, docs/configuration) hold sub-pages the
// same way, but live in ordinary flat sections ("Networking", "Reference") rather than
// their own tiered one — same nesting-only-when-active treatment, just in the plain <ul>
// branch below instead of the tiered one.
import { coverageTierLabel, getServiceSupport, type ServiceSupportManifest } from "../lib/generated-content";
import {
  groupGuideDocs,
  groupServiceDocs,
  parseGuideDocSlug,
  parseServiceDocSlug,
  type ServiceDocLike,
} from "../lib/service-docs";

type NavEntry = ServiceDocLike & { section: string };

interface Props {
  docs: NavEntry[];
  currentSlug: string;
  /** Roomier tap targets for the mobile drawer. */
  compact?: boolean;
  support?: ServiceSupportManifest;
  /** Distinguishes the two copies' element ids. */
  idPrefix?: string;
}

const { docs, currentSlug, compact = false, support = await getServiceSupport(), idPrefix = "docsnav" } = Astro.props;

const linkClass = compact ? "block rounded-md px-3 py-3 text-sm no-underline" : "block rounded-md px-2 py-1.5 text-sm no-underline";
const stateClass = (slug: string) => (slug === currentSlug ? "soft text-(--oc-text)" : "text-muted");
// The current page is marked, not just tinted: `soft` is a background colour, and a
// background colour is not something a screen reader reads out.
const currentAttr = (slug: string) => (slug === currentSlug ? "page" : undefined);
const labelId = (value: string) => `${idPrefix}-${value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;

const serviceGroups = groupServiceDocs(docs);
const activeService = parseServiceDocSlug(currentSlug)?.service ?? null;
const guideGroups = groupGuideDocs(docs);
const activeGuide = parseGuideDocSlug(currentSlug)?.guide ?? null;

// A service's or guide's sub-pages are entries in the docs collection like any other; keep
// them out of the flat per-tier/per-section list so they only ever appear nested under
// their own service or guide.
const visible: NavEntry[] = docs.filter(
  (doc) => parseServiceDocSlug(doc.slug)?.page == null && parseGuideDocSlug(doc.slug)?.page == null,
);

const grouped = Object.entries(
  visible.reduce<Record<string, NavEntry[]>>((groups, entry) => {
    groups[entry.section] ??= [];
    groups[entry.section].push(entry);
    return groups;
  }, {}),
);

// The "Service Reference" section is a flat, alphabetical list of ~50 doc pages — the
// coverage-tier grouping from the upstream service table turns that into four labeled
// clusters instead of one long scroll. coverageTier comes from parsing docs/README.md's
// generated service table at sync time (see sync-overcast-content.ts); a doc with no
// match (e.g. the services index page itself) falls into "Other". The raw tier strings
// are engineering jargon, so headings go through coverageTierLabel() (generated-content.ts)
// for reader-facing wording — tierOrder below stays keyed on the raw strings so sorting
// doesn't depend on the display text.
const tierOrder = [
  "Comprehensive / broad support",
  "Core CRUD + common workflows",
  "Minimal / targeted support",
  "IaC/discovery-oriented stub",
];
const tierForDoc = (entry: NavEntry): string => {
  const docSlug = parseServiceDocSlug(entry.slug)?.service;
  const service = docSlug ? support.services.find((s) => s.docSlug === docSlug) : undefined;
  return service?.coverageTier || "Other";
};
const servicesByTier = (entries: NavEntry[]): Array<[string, NavEntry[]]> => {
  const buckets = new Map<string, NavEntry[]>();
  for (const entry of entries) {
    const tier = tierForDoc(entry);
    buckets.set(tier, [...(buckets.get(tier) ?? []), entry]);
  }
  return [...tierOrder, "Other"].filter((tier) => buckets.has(tier)).map((tier) => [tier, buckets.get(tier)!]);
};

const subPagesFor = (entry: NavEntry) => {
  const service = parseServiceDocSlug(entry.slug)?.service;
  if (service) return service === activeService ? serviceGroups.get(service)?.subPages ?? [] : [];
  const guide = parseGuideDocSlug(entry.slug)?.guide;
  if (guide) return guide === activeGuide ? guideGroups.get(guide)?.subPages ?? [] : [];
  return [];
};
---

{grouped.map(([section, entries]) => (
  <div class={compact ? "mb-5 last:mb-0" : "mb-5"}>
    <p id={labelId(section)} class="mb-2 font-mono text-2xs uppercase tracking-[0.16em] text-muted">{section}</p>
    {section === "Service Reference" ? (
      servicesByTier(entries).map(([tier, tierEntries]) => (
        <div class="mb-3 last:mb-0">
          {/* No `opacity-75` here: it took --oc-muted down to 2.98:1 on the page
              background, on what was the smallest text in the sidebar. The letter
              spacing already sets this a step below the section label above it. */}
          <p id={labelId(`${section}-${tier}`)} class="mb-1 font-mono text-2xs uppercase tracking-[0.12em] text-muted">
            {coverageTierLabel(tier)}
          </p>
          <ul class="m-0 list-none space-y-1 p-0" aria-labelledby={labelId(`${section}-${tier}`)}>
            {tierEntries.map((entry) => (
              <li>
                <a class={`${linkClass} ${stateClass(entry.slug)}`} href={`/${entry.slug}/`} aria-current={currentAttr(entry.slug)}>
                  {entry.title}
                </a>
                {subPagesFor(entry).length > 0 && (
                  <ul class="m-0 ml-3 mt-1 list-none space-y-1 border-l border-oc p-0 pl-2">
                    {subPagesFor(entry).map((page) => (
                      <li>
                        <a class={`${linkClass} ${stateClass(page.slug)}`} href={`/${page.slug}/`} aria-current={currentAttr(page.slug)}>
                          {page.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <ul class="m-0 list-none space-y-1 p-0" aria-labelledby={labelId(section)}>
        {entries?.map((entry) => (
          <li>
            <a class={`${linkClass} ${stateClass(entry.slug)}`} href={`/${entry.slug}/`} aria-current={currentAttr(entry.slug)}>
              {entry.title}
            </a>
            {subPagesFor(entry).length > 0 && (
              <ul class="m-0 ml-3 mt-1 list-none space-y-1 border-l border-oc p-0 pl-2">
                {subPagesFor(entry).map((page) => (
                  <li>
                    <a class={`${linkClass} ${stateClass(page.slug)}`} href={`/${page.slug}/`} aria-current={currentAttr(page.slug)}>
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
))}
