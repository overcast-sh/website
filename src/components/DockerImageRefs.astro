---
// Per-release Docker pull commands. Derived from the release tag, never parsed out of the
// release body markdown — the tag is the one thing every release reliably has.
interface Props {
  version: string; // release tag with any leading "v" stripped, e.g. "0.0.1-alpha.38"
}

const { version } = Astro.props;
const images = [
  { label: "Full image", command: `docker pull ghcr.io/overcast-sh/overcast:${version}` },
  { label: "Slim image", command: `docker pull ghcr.io/overcast-sh/overcast-slim:${version}` },
];
---

<div class="grid gap-2 sm:grid-cols-2">
  {
    images.map(({ label, command }) => (
      <div class="surface flex items-center justify-between gap-3 rounded-md px-3 py-2">
        <div class="min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">{label}</p>
          <code class="block truncate font-mono text-xs text-(--oc-text) sm:text-sm">{command}</code>
        </div>
        <button class="copy-button shrink-0 rounded px-2 py-1 font-mono text-xs" data-copy={command} type="button">
          copy
        </button>
      </div>
    ))
  }
</div>

<script>
  // Multiple DockerImageRefs instances can render on one page (one per release); each one's
  // script queries every `[data-copy]` button on the page, so guard against re-binding a
  // listener onto a button another instance already wired up.
  document.querySelectorAll("[data-copy]").forEach((button) => {
    if (button.hasAttribute("data-copy-bound")) return;
    button.setAttribute("data-copy-bound", "true");
    button.addEventListener("click", async () => {
      const original = button.textContent;
      try {
        await navigator.clipboard.writeText(button.getAttribute("data-copy") || "");
        button.textContent = "copied";
      } catch {
        button.textContent = "copy failed";
      }
      window.setTimeout(() => {
        button.textContent = original;
      }, 1200);
    });
  });
</script>
