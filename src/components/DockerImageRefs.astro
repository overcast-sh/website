---
// Per-release Docker pull commands. Derived from the release tag, never parsed out of the
// release body markdown — the tag is the one thing every release reliably has.
interface Props {
  version: string; // release tag with any leading "v" stripped, e.g. "0.0.1-alpha.38"
}

const { version } = Astro.props;
const images = [
  { label: "Full image", command: `docker pull ghcr.io/overcast-sh/overcast:${version}` },
  { label: "Slim image", command: `docker pull ghcr.io/overcast-sh/overcast-slim:${version}` },
];
---

<div class="grid gap-2 sm:grid-cols-2">
  {
    images.map(({ label, command }) => (
      <div class="surface flex items-center justify-between gap-3 rounded-md px-3 py-2">
        <div class="min-w-0">
          <p class="font-mono text-2xs uppercase tracking-[0.14em] text-muted">{label}</p>
          <code class="block truncate font-mono text-xs text-(--oc-text) sm:text-sm">{command}</code>
        </div>
        {/* Eleven of these can sit on /releases/ at once, so "copy" alone is eleven
            identical accessible names. The click handler is SiteLayout's single
            delegated `[data-copy]` listener. */}
        <button
          class="copy-button inline-flex min-h-6 shrink-0 items-center rounded px-2 py-1 font-mono text-xs"
          data-copy={command}
          data-copy-label={`${label} pull command`}
          aria-label={`Copy the ${label.toLowerCase()} pull command`}
          type="button"
        >
          copy
        </button>
      </div>
    ))
  }
</div>
