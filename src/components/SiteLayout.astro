---
import "../styles/global.css";
import { BookOpen, Download, FileText, GitCompare, Menu, Monitor, PencilLine, RotateCcwClock, Search, ShieldCheck, Star, SunMoon, X } from "@lucide/astro";
import GitHubIcon from "./GitHubIcon.astro";
import { repositoryUrl, starsUrl, websiteEditUrlFromRoute } from "../lib/github-links";
import { getSourceManifest } from "../lib/generated-content";
import { formatDate, toIsoDate } from "../lib/format-date";

interface Props {
  title?: string;
  description?: string;
  editUrl?: string;
  /** Keep a page out of search engines (the 404, which every unknown URL renders). */
  noindex?: boolean;
  /**
   * Title to index this page under in site search. Docs pages mark their own
   * `data-pagefind-body` on the article, so they leave this unset; every other
   * page opts in here — without it pagefind indexes docs only, and /downloads/,
   * /support/ and /releases/ are unreachable from the search box that offers them.
   */
  searchTitle?: string;
}

const {
  title = "Overcast",
  description = "A fast, free, open-source local AWS emulator for development and CI.",
  editUrl,
  searchTitle,
  noindex = false,
} = Astro.props;
const pageEditUrl = editUrl ?? websiteEditUrlFromRoute(Astro.routePattern);
const pageTitle = title === "Overcast" ? title : `${title} | Overcast`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://overcast.sh");
// A raster card, not the SVG one this used to point at: X, Slack, LinkedIn and
// Facebook all refuse to render an SVG og:image, so every link to the site
// unfurled with no picture at all. Generated from brand/github-social-card.svg.
const socialImageUrl = new URL("/brand/social-card.png", Astro.site || "https://overcast.sh");
const sourceManifest = await getSourceManifest();
const builtDate = formatDate(sourceManifest.generatedAt);
const builtIso = toIsoDate(sourceManifest.generatedAt);
const sourceRef = sourceManifest.sourceRef;
const sourceReleaseUrl = sourceRef ? `${repositoryUrl(sourceManifest.repo)}/releases/tag/${sourceRef}` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Overcast" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Overcast — local AWS emulator" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Overcast — local AWS emulator" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/brand/favicon.ico" />
    <meta name="theme-color" content="#F4F8FC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10161D" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      const theme = localStorage.getItem("overcast-theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="soft border-b border-oc">
      <p class="mx-auto max-w-7xl px-4 py-2 text-center font-mono text-xs leading-5 text-body sm:px-6 lg:px-8">
        <strong class="text-(--oc-text)">Overcast is alpha</strong> — behavior and APIs may change between releases.
        Pin your version and <a href="/docs/#alpha-stability">read the changelog</a> before upgrading.
      </p>
    </div>
    <header class="sticky top-0 z-30 border-b border-oc bg-card/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-5 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label="Overcast home">
          <span class="relative h-8 w-8 shrink-0">
            <img src="/brand/mark-light.svg" alt="" class="brand-logo-light h-8 w-8" />
            <img src="/brand/mark-dark.svg" alt="" class="brand-logo-dark h-8 w-8" />
          </span>
          <span class="leading-none">
            <span class="block font-mono text-xl font-bold text-(--oc-text)">overcast</span>
            <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-muted">local AWS emulator</span>
          </span>
        </a>
        <nav class="hidden items-center gap-3.5 font-mono text-xs whitespace-nowrap text-muted xl:flex" aria-label="Main">
          <a href="/docs/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><BookOpen class="icon" />Docs</a>
          <a href="/console/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><Monitor class="icon" />Console</a>
          <a href="/downloads/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><Download class="icon" />Downloads</a>
          <a href="/releases/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><RotateCcwClock class="icon" />Releases</a>
          <a href="/support/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><ShieldCheck class="icon" />Support Matrix</a>
          <a href="/docs/migration-from-localstack/" class="flex items-center gap-1.5 text-muted hover:text-(--oc-text)"><GitCompare class="icon" />LocalStack Migration</a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <button
            id="search-open"
            class="copy-button flex h-11 w-11 items-center justify-center gap-1.5 rounded-md font-mono text-xs sm:h-9 sm:w-auto sm:justify-start sm:px-3"
            type="button"
            aria-label="Search"
          >
            <Search class="icon" />
            <span class="hidden sm:inline">search</span>
            <kbd class="ml-2 hidden text-[10px] sm:inline">/</kbd>
          </button>
          <a
            href={repositoryUrl()}
            class="copy-button hidden h-9 items-center gap-1.5 rounded-md px-3 font-mono text-xs no-underline xl:flex"
          >
            <GitHubIcon />GitHub
          </a>
          <a
            href={starsUrl()}
            class="copy-button hidden h-9 items-center gap-1.5 rounded-md px-3 font-mono text-xs no-underline xl:flex"
          >
            <Star class="icon" />Star
          </a>
          <button
            id="theme-toggle"
            class="copy-button h-11 w-11 rounded-md font-mono text-xs xl:h-9 xl:w-9"
            type="button"
            aria-label="Toggle theme"
          >
            <SunMoon class="mx-auto h-4 w-4" />
          </button>
          <button
            id="menu-toggle"
            class="copy-button flex h-11 w-11 items-center justify-center rounded-md font-mono text-xs xl:hidden"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
          >
            <Menu id="menu-toggle-icon-open" class="icon" />
            <X id="menu-toggle-icon-close" class="icon hidden" />
          </button>
        </div>
      </div>
      <div
        id="mobile-menu"
        class="fixed inset-x-4 top-[4.75rem] z-40 hidden rounded-lg border border-oc bg-card p-2 shadow-2xl xl:hidden"
      >
        <nav class="flex flex-col gap-1 font-mono text-sm" aria-label="Mobile">
          <a href="/docs/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><BookOpen class="icon" />Docs</a>
          <a href="/console/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><Monitor class="icon" />Console</a>
          <a href="/downloads/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><Download class="icon" />Downloads</a>
          <a href="/releases/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><RotateCcwClock class="icon" />Releases</a>
          <a href="/support/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><ShieldCheck class="icon" />Support Matrix</a>
          <a href="/docs/migration-from-localstack/" class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><GitCompare class="icon" />LocalStack Migration</a>
          <div class="my-1 border-t border-oc"></div>
          <a href={repositoryUrl()} class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><GitHubIcon />GitHub</a>
          <a href={starsUrl()} class="flex items-center gap-2 rounded-md px-3 py-3 text-muted no-underline hover:bg-(--oc-accent-soft)"><Star class="icon" />Star</a>
        </nav>
      </div>
      <div id="search-overlay" class="fixed inset-0 z-50 hidden">
        <div id="search-scrim" class="absolute inset-0 bg-(--oc-scrim) backdrop-blur-[1px]"></div>
        <div
          id="search-panel"
          class="absolute inset-x-3 top-16 mx-auto flex max-h-[80vh] max-w-2xl flex-col overflow-hidden rounded-lg border border-oc bg-card shadow-2xl sm:inset-x-4 sm:top-24"
          role="dialog"
          aria-modal="true"
          aria-labelledby="search-title"
        >
          <h2 id="search-title" class="sr-only">Search Overcast</h2>
          <div class="flex items-center gap-2 border-b border-oc p-3">
            <label class="sr-only" for="search-input">Search</label>
            <div class="relative min-w-0 flex-1">
              <Search class="icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
              <input
                id="search-input"
                class="w-full rounded-md border border-oc bg-page py-2.5 pl-9 pr-9 font-mono text-sm text-(--oc-text)"
                placeholder="Search docs, services, downloads…"
                type="text"
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-expanded="false"
                aria-controls="search-results"
                aria-autocomplete="list"
              />
              <img
                id="search-loading"
                src="/brand/overcast-loader.svg"
                alt=""
                width="16"
                height="16"
                class="pointer-events-none absolute right-2.5 top-1/2 hidden h-4 w-4 -translate-y-1/2"
              />
            </div>
            <button
              id="search-close"
              type="button"
              class="copy-button flex h-11 w-11 shrink-0 items-center justify-center rounded-md sm:h-10 sm:w-10"
              aria-label="Close search"
            >
              <X class="icon" />
            </button>
          </div>
          <div id="search-results" class="min-h-0 flex-1 overflow-y-auto p-2 text-sm" role="listbox" aria-label="Search results"></div>
          <div class="flex items-center justify-between gap-3 border-t border-oc px-3 py-2 font-mono text-[11px] text-muted">
            <span id="search-count" aria-hidden="true"></span>
            <span class="hidden gap-3 sm:flex">
              <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
              <span><kbd>↵</kbd> open</span>
              <span><kbd>esc</kbd> close</span>
            </span>
          </div>
          <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
        </div>
      </div>
    </header>
    <main
      id="main-content"
      class="flex-1"
      tabindex="-1"
      data-pagefind-body={searchTitle ? true : undefined}
      data-pagefind-meta={searchTitle ? `title:${searchTitle}` : undefined}
    >
      <slot />
    </main>
    <footer class="border-t border-oc bg-card">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-[1fr_auto] md:gap-16">
          <div class="max-w-sm">
            <a href="/" class="inline-flex items-center gap-2 no-underline" aria-label="Overcast home">
              <span class="relative h-7 w-7 shrink-0">
                <img src="/brand/mark-light.svg" alt="" class="brand-logo-light h-7 w-7" />
                <img src="/brand/mark-dark.svg" alt="" class="brand-logo-dark h-7 w-7" />
              </span>
              <span class="font-mono text-lg font-bold text-(--oc-text)">overcast</span>
            </a>
            <p class="m-0 mt-3 text-sm leading-6 text-muted">
              A fast, free, open-source local AWS emulator for development and CI.
            </p>
            {pageEditUrl && (
              <a href={pageEditUrl} class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs">
                <PencilLine class="icon" />Edit this page
              </a>
            )}
          </div>
          <nav class="grid grid-cols-2 gap-10 sm:gap-16" aria-label="Footer">
            <div>
              <p class="m-0 font-mono text-xs uppercase tracking-[0.16em] text-muted">Product</p>
              <ul class="m-0 mt-3 flex list-none flex-col gap-2.5 p-0 text-sm">
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/docs/">Docs</a></li>
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/console/">Web Console</a></li>
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/downloads/">Downloads</a></li>
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/releases/">Releases</a></li>
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/support/">Support Matrix</a></li>
                <li><a class="text-muted no-underline hover:text-(--oc-text)" href="/docs/migration-from-localstack/">LocalStack Migration</a></li>
              </ul>
            </div>
            <div>
              <p class="m-0 font-mono text-xs uppercase tracking-[0.16em] text-muted">Project</p>
              <ul class="m-0 mt-3 flex list-none flex-col gap-2.5 p-0 text-sm">
                <li><a class="inline-flex items-center gap-1.5 text-muted no-underline hover:text-(--oc-text)" href={repositoryUrl()}><GitHubIcon />GitHub</a></li>
                <li><a class="inline-flex items-center gap-1.5 text-muted no-underline hover:text-(--oc-text)" href={starsUrl()}><Star class="icon" />Star Overcast</a></li>
                <li><a class="inline-flex items-center gap-1.5 text-muted no-underline hover:text-(--oc-text)" href="/contributing/"><PencilLine class="icon" />Contributing</a></li>
                <li><a class="inline-flex items-center gap-1.5 text-muted no-underline hover:text-(--oc-text)" href={`${repositoryUrl()}/blob/main/LICENSE`}><FileText class="icon" />MIT License</a></li>
              </ul>
            </div>
          </nav>
        </div>
        <div class="mt-10 flex flex-col gap-3 border-t border-oc pt-6 md:flex-row md:items-end md:justify-between">
          <p class="m-0 max-w-2xl text-xs leading-5 text-muted">
            Overcast is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by
            Amazon Web Services. AWS and AWS service names are trademarks of Amazon.com, Inc. or its affiliates, used
            only to describe compatibility.
          </p>
          {builtDate && (
            <p class="m-0 shrink-0 font-mono text-xs text-muted">
              Built <time datetime={builtIso}>{builtDate}</time>{sourceRef && (
                <> from <a href={sourceReleaseUrl}>Overcast {sourceRef}</a></>
              )}
            </p>
          )}
        </div>
      </div>
    </footer>
    <script is:inline>
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("overcast-theme", next);
      });

      const overlay = document.getElementById("search-overlay");
      const panel = document.getElementById("search-panel");
      const input = document.getElementById("search-input");
      const results = document.getElementById("search-results");
      const status = document.getElementById("search-status");
      const countLabel = document.getElementById("search-count");
      const loadingIcon = document.getElementById("search-loading");
      const trigger = document.getElementById("search-open");
      const closeButton = document.getElementById("search-close");

      const menuTrigger = document.getElementById("menu-toggle");
      const menuOpenIcon = document.getElementById("menu-toggle-icon-open");
      const menuCloseIcon = document.getElementById("menu-toggle-icon-close");
      const menuPanel = document.getElementById("mobile-menu");

      const openMenu = () => {
        menuPanel?.classList.remove("hidden");
        menuTrigger?.setAttribute("aria-expanded", "true");
        menuTrigger?.setAttribute("aria-label", "Close menu");
        menuOpenIcon?.classList.add("hidden");
        menuCloseIcon?.classList.remove("hidden");
      };
      const closeMenu = ({ returnFocus = false } = {}) => {
        if (menuPanel?.classList.contains("hidden")) return;
        menuPanel?.classList.add("hidden");
        menuTrigger?.setAttribute("aria-expanded", "false");
        menuTrigger?.setAttribute("aria-label", "Open menu");
        menuOpenIcon?.classList.remove("hidden");
        menuCloseIcon?.classList.add("hidden");
        if (returnFocus) menuTrigger?.focus();
      };
      menuTrigger?.addEventListener("click", () => {
        if (menuPanel?.classList.contains("hidden")) {
          closeSearch();
          openMenu();
        } else {
          closeMenu();
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !menuPanel?.classList.contains("hidden")) {
          closeMenu({ returnFocus: true });
        }
      });
      document.addEventListener("click", (event) => {
        if (menuPanel?.classList.contains("hidden")) return;
        const target = event.target;
        if (menuPanel.contains(target) || menuTrigger?.contains(target)) return;
        closeMenu();
      });
      const desktopNavQuery = window.matchMedia("(min-width: 1280px)");
      desktopNavQuery.addEventListener("change", (event) => {
        if (event.matches) closeMenu();
      });

      const DEBOUNCE_MS = 150;
      const MAX_SHOWN = 12;
      const SUGGESTIONS = ["s3", "endpoint url", "cdk deploy", "lambda docker", "sqs fifo", "migrate from localstack"];

      let debounceTimer;
      let requestId = 0;
      let activeIndex = -1;
      let pagefindPromise = null;

      const loadPagefind = () => {
        if (!pagefindPromise) {
          pagefindPromise = import("/pagefind/pagefind.js").catch((error) => {
            pagefindPromise = null;
            throw error;
          });
        }
        return pagefindPromise;
      };

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);

      const setLoading = (isLoading) => loadingIcon?.classList.toggle("hidden", !isLoading);
      const setStatus = (message) => {
        if (status) status.textContent = message;
      };
      const setCount = (message) => {
        if (countLabel) countLabel.textContent = message;
      };

      const clearResults = () => {
        results.innerHTML = "";
        activeIndex = -1;
        input?.removeAttribute("aria-activedescendant");
      };

      // Which part of the site a hit belongs to. Ordering matters: the label is
      // also the group heading, and groups are shown best-scoring-group first.
      const sectionFor = (url) => {
        if (url.startsWith("/docs/services/")) return "Service reference";
        if (url.startsWith("/docs/cdk/")) return "CDK guides";
        if (url.startsWith("/docs/")) return "Guides & reference";
        return "Site";
      };

      const tokenize = (value) =>
        String(value ?? "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, " ")
          .trim()
          .split(" ")
          .filter(Boolean);

      // Pagefind ranks on body-text frequency alone, which buries the page a
      // query names outright ("s3" put /docs/sdk-cli/ above /docs/services/s3/).
      // Re-rank on top of its order: an exact title or slug match wins, then
      // partial title coverage, then pagefind's own ordering as the tiebreak.
      const scoreRow = (row, index, total, queryTokens, rawQuery) => {
        const title = String(row.meta?.title ?? "");
        const titleTokens = tokenize(title);
        const slug = row.url.replace(/\/+$/, "").split("/").pop() ?? "";
        let score = (total - index) / total;
        if (title.toLowerCase() === rawQuery) score += 6;
        if (slug.toLowerCase() === rawQuery.replace(/\s+/g, "-")) score += 5;
        if (titleTokens.length && queryTokens.every((token) => titleTokens.includes(token))) score += 3;
        const matched = queryTokens.filter((token) =>
          titleTokens.some((titleToken) => titleToken.startsWith(token)),
        ).length;
        if (queryTokens.length) score += (matched / queryTokens.length) * 2;
        return score;
      };

      const renderPanelMessage = (html, statusMessage) => {
        clearResults();
        results.innerHTML = `<div class="px-3 py-6 text-center text-sm text-muted">${html}</div>`;
        setCount("");
        if (statusMessage) setStatus(statusMessage);
      };

      const renderIdleState = () => {
        clearResults();
        results.innerHTML = `<div class="px-3 py-4">
            <p class="m-0 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">try searching for</p>
            <div class="mt-3 flex flex-wrap gap-2">${SUGGESTIONS.map(
              (suggestion) =>
                `<button type="button" data-suggestion="${escapeHtml(suggestion)}" class="copy-button rounded-md px-2.5 py-1.5 font-mono text-xs">${escapeHtml(suggestion)}</button>`,
            ).join("")}</div>
          </div>`;
        setCount("");
        setStatus("");
      };

      const highlightResult = (index) => {
        const items = results.querySelectorAll("[data-result]");
        items.forEach((item, i) => {
          const active = i === index;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
        });
        activeIndex = index;
        if (index >= 0) {
          input?.setAttribute("aria-activedescendant", `search-result-${index}`);
          items[index]?.scrollIntoView({ block: "nearest" });
        } else {
          input?.removeAttribute("aria-activedescendant");
        }
      };

      const renderResults = (ranked, query) => {
        const shown = ranked.slice(0, MAX_SHOWN);
        const groups = [];
        shown.forEach((entry) => {
          const name = sectionFor(entry.row.url);
          let group = groups.find((candidate) => candidate.name === name);
          if (!group) {
            group = { name, entries: [] };
            groups.push(group);
          }
          group.entries.push(entry);
        });

        let index = 0;
        const html = groups
          .map((group) => {
            const rows = group.entries
              .map((entry) => {
                const row = entry.row;
                const id = index++;
                // Deep links live in a sibling row, never inside the result's own
                // <a>: a nested anchor is invalid HTML and the parser hoists it
                // out of the card, which is exactly how it looked.
                const anchors = (row.sub_results || [])
                  .filter((sub) => sub.url && sub.url.includes("#"))
                  .slice(0, 2)
                  .map(
                    (sub) =>
                      `<a class="search-anchor" tabindex="-1" href="${escapeHtml(sub.url)}"># ${escapeHtml(sub.title)}</a>`,
                  )
                  .join("");
                return `<a id="search-result-${id}" data-result role="option" aria-selected="false" tabindex="-1" class="search-result" href="${escapeHtml(row.url)}">
                    <span class="search-result-title">${escapeHtml(row.meta?.title ?? row.url)}</span>
                    <span class="search-result-url">${escapeHtml(row.url)}</span>
                    <span class="search-result-excerpt">${row.excerpt}</span>
                  </a>${anchors ? `<span class="search-anchors">${anchors}</span>` : ""}`;
              })
              .join("");
            return `<div role="group" aria-label="${escapeHtml(group.name)}"><p class="search-group">${escapeHtml(group.name)}</p>${rows}</div>`;
          })
          .join("");

        results.innerHTML = html;
        activeIndex = -1;
        const total = ranked.length;
        setCount(total > shown.length ? `${shown.length} of ${total} results` : `${total} result${total === 1 ? "" : "s"}`);
        setStatus(`${total} result${total === 1 ? "" : "s"} for ${query}`);
      };

      const runSearch = async (query) => {
        const thisRequest = ++requestId;
        setLoading(true);
        setStatus("Searching…");
        try {
          const pagefind = await loadPagefind();
          if (thisRequest !== requestId) return;
          const search = await pagefind.search(query);
          if (thisRequest !== requestId) return;
          const rows = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
          if (thisRequest !== requestId) return;
          if (rows.length === 0) {
            renderPanelMessage(
              `<p class="m-0">Nothing matched <strong class="font-mono text-(--oc-text)">${escapeHtml(query)}</strong>.</p>
               <p class="m-0 mt-3">Try a service name, or check whether the operation exists at all:</p>
               <p class="m-0 mt-3 flex flex-wrap justify-center gap-2">
                 <a class="copy-button rounded-md px-2.5 py-1.5 font-mono text-xs no-underline" href="/support/">Support matrix</a>
                 <a class="copy-button rounded-md px-2.5 py-1.5 font-mono text-xs no-underline" href="/docs/">All docs</a>
               </p>`,
              `No results for ${query}`,
            );
            return;
          }
          const queryTokens = tokenize(query);
          const rawQuery = query.trim().toLowerCase();
          const ranked = rows
            .map((row, index) => ({ row, score: scoreRow(row, index, rows.length, queryTokens, rawQuery) }))
            .sort((a, b) => b.score - a.score);
          renderResults(ranked, query);
        } catch (error) {
          if (thisRequest !== requestId) return;
          renderPanelMessage(
            `<p class="m-0">Search is unavailable right now.</p>
             <p class="m-0 mt-3"><a class="font-mono text-xs" href="/docs/">Browse the docs instead</a></p>`,
            "Search is unavailable right now.",
          );
        } finally {
          if (thisRequest === requestId) setLoading(false);
        }
      };

      const openSearch = () => {
        closeMenu();
        overlay?.classList.remove("hidden");
        document.documentElement.classList.add("search-open");
        input?.setAttribute("aria-expanded", "true");
        loadPagefind().catch(() => {});
        if (!input?.value.trim()) renderIdleState();
        input?.focus();
        input?.select();
      };
      const closeSearch = ({ returnFocus = false } = {}) => {
        if (overlay?.classList.contains("hidden")) return;
        overlay?.classList.add("hidden");
        document.documentElement.classList.remove("search-open");
        input?.setAttribute("aria-expanded", "false");
        requestId++;
        setLoading(false);
        if (returnFocus) trigger?.focus();
      };
      const searchIsOpen = () => !overlay?.classList.contains("hidden");

      trigger?.addEventListener("click", openSearch);
      closeButton?.addEventListener("click", () => closeSearch({ returnFocus: true }));
      document.getElementById("search-scrim")?.addEventListener("click", () => closeSearch());

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "/" &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.altKey &&
          !searchIsOpen() &&
          !document.activeElement?.closest("input, textarea, select, [contenteditable='true']")
        ) {
          event.preventDefault();
          openSearch();
        }
        if (event.key === "k" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          openSearch();
        }
        if (event.key === "Escape" && searchIsOpen()) {
          closeSearch({ returnFocus: true });
        }
        // The panel is aria-modal, so keep Tab inside it while it is open.
        if (event.key === "Tab" && searchIsOpen() && panel) {
          const focusable = panel.querySelectorAll("a[href], button, input, [tabindex]:not([tabindex='-1'])");
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });

      results?.addEventListener("click", (event) => {
        const suggestion = event.target.closest("[data-suggestion]");
        if (!suggestion || !input) return;
        input.value = suggestion.getAttribute("data-suggestion") || "";
        input.focus();
        runSearch(input.value);
      });

      input?.addEventListener("input", () => {
        const query = input.value.trim();
        clearTimeout(debounceTimer);
        if (!query) {
          requestId++;
          setLoading(false);
          renderIdleState();
          return;
        }
        debounceTimer = window.setTimeout(() => runSearch(query), DEBOUNCE_MS);
      });

      input?.addEventListener("keydown", (event) => {
        const items = results.querySelectorAll("[data-result]");
        if (event.key === "ArrowDown") {
          if (!items.length) return;
          event.preventDefault();
          highlightResult((activeIndex + 1) % items.length);
        } else if (event.key === "ArrowUp") {
          if (!items.length) return;
          event.preventDefault();
          highlightResult((activeIndex - 1 + items.length) % items.length);
        } else if (event.key === "Home" && items.length) {
          event.preventDefault();
          highlightResult(0);
        } else if (event.key === "End" && items.length) {
          event.preventDefault();
          highlightResult(items.length - 1);
        } else if (event.key === "Enter") {
          // Enter with nothing highlighted opens the top hit rather than doing nothing.
          const target = activeIndex >= 0 ? items[activeIndex] : items[0];
          if (target) {
            event.preventDefault();
            target.click();
          }
        }
      });
    </script>
    <script is:inline>
      // Every date on the site is baked at build time in UTC, so "31 Aug 2026" can be
      // yesterday or tomorrow depending on where it is being read, and it is always
      // formatted the build's way rather than the reader's. Re-render each
      // <time datetime> in the reader's own locale and timezone; the server-rendered
      // text stays as the no-JS fallback. <option> is skipped — its text is the
      // select's own label, which the version jump list composes inline.
      document.querySelectorAll("time[datetime]").forEach((element) => {
        if (element.closest("option")) return;
        const value = new Date(element.getAttribute("datetime"));
        if (Number.isNaN(value.getTime())) return;
        try {
          element.textContent = new Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(value);
        } catch {
          // Leave the build-time text in place.
        }
      });
    </script>
    <script is:inline>
      const COPY_ICON =
        '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
      const CHECK_ICON =
        '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';

      document.querySelectorAll(".prose pre.astro-code").forEach((pre) => {
        const code = pre.textContent?.replace(/\n$/, "") ?? "";

        const wrap = document.createElement("div");
        wrap.className = "code-block-wrap";
        pre.replaceWith(wrap);
        wrap.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-button code-copy-btn";
        button.setAttribute("aria-label", "Copy code");
        button.innerHTML = COPY_ICON;
        wrap.appendChild(button);

        let resetTimer;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            return;
          }
          window.clearTimeout(resetTimer);
          button.innerHTML = CHECK_ICON;
          button.classList.add("is-copied");
          button.setAttribute("aria-label", "Copied!");
          resetTimer = window.setTimeout(() => {
            button.innerHTML = COPY_ICON;
            button.classList.remove("is-copied");
            button.setAttribute("aria-label", "Copy code");
          }, 1500);
        });
      });
    </script>
  </body>
</html>