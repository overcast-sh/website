---
import "../styles/global.css";
import { BookOpen, Download, FileText, PencilLine, RotateCcwClock, Search, ShieldCheck, Star, SunMoon } from "@lucide/astro";
import GitHubIcon from "./GitHubIcon.astro";
import { repositoryUrl, starsUrl, websiteEditUrlFromRoute } from "../lib/github-links";

interface Props {
  title?: string;
  description?: string;
  editUrl?: string;
}

const {
  title = "Overcast",
  description = "A fast, free, open-source local AWS emulator for development and CI.",
  editUrl,
} = Astro.props;
const pageEditUrl = editUrl ?? websiteEditUrlFromRoute(Astro.routePattern);
const pageTitle = title === "Overcast" ? title : `${title} | Overcast`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://overcast.sh");
const socialImageUrl = new URL("/brand/github-social-card.svg", Astro.site || "https://overcast.sh");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Overcast" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/brand/favicon.ico" />
    <script is:inline>
      const theme = localStorage.getItem("overcast-theme");
      if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class="bg-page">
    <header class="sticky top-0 z-30 border-b border-oc bg-card/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-5 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label="Overcast home">
          <span class="relative h-8 w-8 shrink-0">
            <img src="/brand/mark-light.svg" alt="" class="brand-logo-light h-8 w-8" />
            <img src="/brand/mark-dark.svg" alt="" class="brand-logo-dark h-8 w-8" />
          </span>
          <span class="leading-none">
            <span class="block font-mono text-xl font-bold text-(--oc-text)">overcast</span>
            <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-muted">local AWS emulator</span>
          </span>
        </a>
        <nav class="hidden items-center gap-4 font-mono text-xs text-muted md:flex">
          <a href="/docs/" class="flex items-center gap-1.5 text-muted"><BookOpen class="icon" />Docs</a>
          <a href="/downloads/" class="flex items-center gap-1.5 text-muted"><Download class="icon" />Downloads</a>
          <a href="/releases/" class="flex items-center gap-1.5 text-muted"><RotateCcwClock class="icon" />Releases</a>
          <a href="/support/" class="flex items-center gap-1.5 text-muted"><ShieldCheck class="icon" />Support Matrix</a>
          <a href="/compare/localstack/" class="text-muted">LocalStack Migration</a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <button
            id="search-open"
            class="copy-button hidden h-9 items-center gap-1.5 rounded-md px-3 font-mono text-xs sm:flex"
            type="button"
          >
            <Search class="icon" />search <kbd class="ml-2 text-[10px]">/</kbd>
          </button>
          <a
            href={repositoryUrl()}
            class="copy-button flex h-9 items-center gap-1.5 rounded-md px-3 font-mono text-xs no-underline"
          >
            <GitHubIcon />GitHub
          </a>
          <a
            href={starsUrl()}
            class="copy-button hidden h-9 items-center gap-1.5 rounded-md px-3 font-mono text-xs no-underline sm:flex"
          >
            <Star class="icon" />Star
          </a>
          <button id="theme-toggle" class="copy-button h-9 w-9 rounded-md font-mono text-xs" type="button" aria-label="Toggle theme">
            <SunMoon class="mx-auto h-4 w-4" />
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-oc bg-card">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-8 text-sm text-muted sm:px-6 lg:px-8 md:grid-cols-[1fr_auto]">
        <div>
          {pageEditUrl && (
            <a href={pageEditUrl} class="mb-4 inline-flex items-center gap-1.5 font-mono text-xs">
              <PencilLine class="icon" />Edit this page
            </a>
          )}
          <p class="m-0 max-w-3xl">
            Overcast is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by
            Amazon Web Services. AWS and AWS service names are trademarks of Amazon.com, Inc. or its affiliates, used
            only to describe compatibility.
          </p>
        </div>
        <div class="flex flex-wrap gap-4 font-mono text-xs md:justify-end">
          <a class="inline-flex items-center gap-1.5" href={repositoryUrl()}><GitHubIcon />GitHub</a>
          <a class="inline-flex items-center gap-1.5" href={starsUrl()}><Star class="icon" />Star Overcast</a>
          <a class="inline-flex items-center gap-1.5" href="/contributing/"><PencilLine class="icon" />Contributing</a>
          <a class="inline-flex items-center gap-1.5" href={`${repositoryUrl()}/blob/main/LICENSE`}><FileText class="icon" />MIT License</a>
        </div>
      </div>
    </footer>
    <div id="search-panel" class="fixed inset-x-4 top-20 z-50 mx-auto hidden max-w-2xl rounded-lg border border-oc bg-card p-3 shadow-2xl">
      <label class="sr-only" for="search-input">Search</label>
      <input id="search-input" class="w-full rounded-md border border-oc bg-page px-3 py-2 font-mono text-sm text-(--oc-text)" placeholder="Search docs, services, releases..." />
      <div id="search-results" class="mt-3 max-h-96 overflow-auto text-sm"></div>
    </div>
    <script is:inline>
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("overcast-theme", next);
      });

      const panel = document.getElementById("search-panel");
      const input = document.getElementById("search-input");
      const results = document.getElementById("search-results");
      const openSearch = () => {
        panel?.classList.remove("hidden");
        input?.focus();
      };
      const closeSearch = () => panel?.classList.add("hidden");
      document.getElementById("search-open")?.addEventListener("click", openSearch);
      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && document.activeElement?.tagName !== "INPUT") {
          event.preventDefault();
          openSearch();
        }
        if (event.key === "Escape") closeSearch();
      });
      input?.addEventListener("input", async () => {
        const query = input.value.trim();
        if (!query) {
          results.innerHTML = "";
          return;
        }
        const pagefind = await import("/pagefind/pagefind.js");
        const search = await pagefind.search(query);
        const rows = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
        results.innerHTML = rows
          .map((row) => `<a class="block rounded-md px-3 py-2 no-underline hover:soft" href="${row.url}"><strong class="font-mono text-(--oc-text)">${row.meta.title}</strong><span class="block text-muted">${row.excerpt}</span></a>`)
          .join("");
      });
    </script>
  </body>
</html>
