---
import SiteLayout from "../components/SiteLayout.astro";
import AssetDownloadList from "../components/AssetDownloadList.astro";
import DockerImageRefs from "../components/DockerImageRefs.astro";
import ReleaseChangelog from "../components/ReleaseChangelog.astro";
import VersionJumpSelect from "../components/VersionJumpSelect.astro";
import Chip from "../components/Chip.astro";
import { ChevronDown, Container, FileText, PackageCheck, PackageOpen, RotateCcwClock } from "@lucide/astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { cappedAreas, changelogRollup, sortReleasesNewestFirst } from "../lib/releases";
import { formatDate, formatDateTimeTitle, toIsoDate } from "../lib/format-date";

const headerAreaCap = 5;

const releases: CollectionEntry<"releases">[] = sortReleasesNewestFirst(await getCollection("releases"));
const latest = releases[0];
const olderReleases = releases.slice(1);

function dockerVersion(tagName: string): string {
  return tagName.replace(/^v/, "");
}

const latestDate = formatDate(latest?.data.publishedAt);
---

<SiteLayout title="Releases" description="Overcast release history and release assets." searchTitle="Releases">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><RotateCcwClock class="icon" />release history</p>
    <h1 class="mt-2 font-mono text-3xl font-bold">Overcast releases</h1>
    <p class="mt-4 leading-7 text-body">
      Download native binaries directly from any listed release below, or open a release on GitHub for full change
      details.
    </p>

    {releases.length > 1 && (
      <div class="mt-6">
        <VersionJumpSelect releases={releases.map((release) => ({ tagName: release.data.tagName, name: release.data.name, publishedAt: release.data.publishedAt }))} />
      </div>
    )}

    {latest && (
      <article id={latest.data.tagName} class="surface mt-8 scroll-mt-24 rounded-lg p-5">
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-oc pb-4">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">latest release</p>
            <h2 class="mt-2 flex flex-wrap items-center gap-2 font-mono text-xl font-bold">
              {latest.data.name}
              {latest.data.prerelease && <span class="rounded soft px-2 py-1 font-mono text-xs text-accent">prerelease</span>}
            </h2>
            {latestDate && (
              <p class="mt-1 text-sm text-muted">
                Published <time datetime={toIsoDate(latest.data.publishedAt)} title={formatDateTimeTitle(latest.data.publishedAt)}>{latestDate}</time>
              </p>
            )}
          </div>
          <a class="copy-button inline-flex items-center gap-2 rounded-md px-3 py-2 font-mono text-xs no-underline" href={latest.data.url}>
            <FileText class="icon" />View on GitHub
          </a>
        </div>

        <div class="mt-5">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><Container class="icon" />Docker images</p>
          <div class="mt-3">
            <DockerImageRefs version={dockerVersion(latest.data.tagName)} />
          </div>
        </div>

        <div class="mt-5">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><PackageOpen class="icon" />Downloads</p>
          {latest.data.assets.length > 0 ? (
            <div class="surface mt-3 overflow-hidden rounded-lg">
              <AssetDownloadList assets={latest.data.assets} />
            </div>
          ) : (
            <p class="mt-3 text-sm leading-6 text-body">
              Release asset metadata could not be loaded for this build. Use the
              <a href={latest.data.url}> GitHub release page</a> for downloads.
            </p>
          )}
        </div>

        <div class="mt-6 border-t border-oc pt-6">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><FileText class="icon" />Changelog</p>
          {latest.data.changelogSections.length > 0 ? (
            <div class="mt-4">
              <ReleaseChangelog sections={latest.data.changelogSections} defaultOpen />
            </div>
          ) : latest.rendered?.html ? (
            <details class="group mt-4 rounded-lg border border-oc">
              <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-muted [&::-webkit-details-marker]:hidden">
                <ChevronDown class="icon shrink-0 transition-transform duration-150 group-open:rotate-180" />
                Full changelog
              </summary>
              <div class="prose border-t border-oc px-4 py-4" set:html={latest.rendered.html}></div>
            </details>
          ) : (
            <p class="mt-4 text-sm leading-6 text-body">
              Release notes could not be loaded for this build. Check the
              <a href={latest.data.url}> GitHub release page</a> for the full changelog.
            </p>
          )}
        </div>
      </article>
    )}

    {/* Every superseded changelog on one page would swamp site search: a query for
        any AWS noun would match a dozen historical entries before the doc that
        explains it. Only the current release stays indexed. */}
    {olderReleases.length > 0 && (
      <div class="mt-8" data-pagefind-ignore>
        <h2 class="font-mono text-xl font-bold">Older versions</h2>
        <div class="mt-4 space-y-3">
          {olderReleases.map((release) => {
            const releaseDate = formatDate(release.data.publishedAt);
            const rollup = changelogRollup(release.data.changelogSections);
            const areaPreview = rollup ? cappedAreas(rollup.areas, headerAreaCap) : null;
            return (
              <details id={release.data.tagName} class="surface group scroll-mt-24 rounded-lg">
                <summary class="flex cursor-pointer list-none flex-col gap-1.5 px-5 py-4 [&::-webkit-details-marker]:hidden">
                  <div class="flex flex-wrap items-center gap-3">
                    <ChevronDown class="icon shrink-0 text-muted transition-transform duration-150 group-open:rotate-180" />
                    <span class="font-mono text-base font-bold">{release.data.name}</span>
                    {release.data.prerelease && <span class="rounded soft px-2 py-1 font-mono text-xs text-accent">prerelease</span>}
                    {releaseDate && (
                      <time class="text-sm text-muted" datetime={toIsoDate(release.data.publishedAt)} title={formatDateTimeTitle(release.data.publishedAt)}>
                        {releaseDate}
                      </time>
                    )}
                    {release.data.assets.length > 0 && (
                      <span class="ml-auto flex items-center gap-2 font-mono text-xs text-muted">
                        <PackageCheck class="icon" />{release.data.assets.length} asset{release.data.assets.length === 1 ? "" : "s"}
                      </span>
                    )}
                  </div>
                  {rollup && (
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 pl-7 font-mono text-xs text-muted">
                      <span>
                        {rollup.counts.map((count, index) => (
                          <>
                            {index > 0 && " · "}
                            {`${count.count} ${count.label.toLowerCase()}`}
                          </>
                        ))}
                        {rollup.breakingCount > 0 && (
                          <>
                            {" "}
                            · <span class="text-(--oc-danger)">{rollup.breakingCount} breaking</span>
                          </>
                        )}
                      </span>
                      {areaPreview && areaPreview.shown.length > 0 && (
                        <span class="flex flex-wrap items-center gap-1">
                          {areaPreview.shown.map((area) => (
                            <Chip tone="muted">{area}</Chip>
                          ))}
                          {areaPreview.more > 0 && <span>+{areaPreview.more} more</span>}
                        </span>
                      )}
                    </div>
                  )}
                </summary>
                <div class="border-t border-oc px-5 py-4">
                  <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><Container class="icon" />Docker images</p>
                  <div class="mt-3">
                    <DockerImageRefs version={dockerVersion(release.data.tagName)} />
                  </div>

                  <p class="mt-5 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><PackageOpen class="icon" />Downloads</p>
                  {release.data.assets.length > 0 ? (
                    <div class="surface mt-3 overflow-hidden rounded-lg">
                      <AssetDownloadList assets={release.data.assets} />
                    </div>
                  ) : (
                    <p class="mt-3 text-sm leading-6 text-body">No release assets were published for this version.</p>
                  )}

                  <div class="mt-5 border-t border-oc pt-5">
                    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><FileText class="icon" />Changelog</p>
                    {release.data.changelogSections.length > 0 ? (
                      <div class="mt-4">
                        <ReleaseChangelog sections={release.data.changelogSections} />
                      </div>
                    ) : release.rendered?.html ? (
                      <>
                        {release.data.summary && <p class="mt-3 text-sm leading-6 text-body">{release.data.summary}</p>}
                        <details class="group mt-3 rounded-lg border border-oc">
                          <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-muted [&::-webkit-details-marker]:hidden">
                            <ChevronDown class="icon shrink-0 transition-transform duration-150 group-open:rotate-180" />
                            Full changelog
                          </summary>
                          <div class="prose border-t border-oc px-4 py-4" set:html={release.rendered.html}></div>
                        </details>
                      </>
                    ) : (
                      release.data.summary && <p class="mt-3 text-sm leading-6 text-body">{release.data.summary}</p>
                    )}
                  </div>

                  <a class="mt-5 inline-flex items-center gap-2 font-mono text-xs" href={release.data.url}>
                    <FileText class="icon" />View on GitHub
                  </a>
                </div>
              </details>
            );
          })}
        </div>
      </div>
    )}

    {releases.length === 0 && (
      <div class="surface mt-8 rounded-lg p-5 text-sm leading-6 text-body">
        GitHub release metadata could not be loaded for this build. Check the
        <a href="https://github.com/overcast-sh/overcast/releases"> GitHub releases page</a> for published versions and assets.
      </div>
    )}
  </section>
</SiteLayout>
