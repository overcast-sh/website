---
import SiteLayout from "../components/SiteLayout.astro";
import SearchPromo from "../components/SearchPromo.astro";
import { ArrowRight, BookOpen, Download, SearchX, ShieldCheck } from "@lucide/astro";
---

<SiteLayout title="Page Not Found" description="The requested Overcast page could not be found." noindex>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><SearchX class="icon" />not found</p>
    <h1 class="mt-2 font-mono text-4xl font-bold">This page is not here.</h1>
    <p class="mt-4 leading-7 text-body">
      A doc may have been renamed in a later Overcast release. Search for it below.
    </p>

    <div class="mt-6 sm:mt-8">
      <SearchPromo label="Search for the page you wanted" />
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <a class="surface flex items-center gap-3 rounded-lg p-5 font-mono text-sm no-underline" href="/docs/">
        <span class="icon-tile"><BookOpen class="icon" /></span>Docs
      </a>
      <a class="surface flex items-center gap-3 rounded-lg p-5 font-mono text-sm no-underline" href="/support/">
        <span class="icon-tile"><ShieldCheck class="icon" /></span>Support matrix
      </a>
      <a class="surface flex items-center gap-3 rounded-lg p-5 font-mono text-sm no-underline" href="/downloads/">
        <span class="icon-tile"><Download class="icon" /></span>Downloads
      </a>
    </div>

    <a class="mt-8 inline-flex items-center gap-2 font-mono text-sm" href="/">Back home<ArrowRight class="icon" /></a>
  </section>
</SiteLayout>
