---
import SiteLayout from "../components/SiteLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import AssetDownloadList from "../components/AssetDownloadList.astro";
import ChangelogEntryBody from "../components/ChangelogEntryBody.astro";
import Chip from "../components/Chip.astro";
import InstallTabs from "../components/InstallTabs.astro";
import { ArrowRight, Binary, Container, Download, FileText, Monitor, PackageOpen, RotateCcwClock } from "@lucide/astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { repositoryUrl } from "../lib/github-links";
import { formatDate, formatDateTimeTitle, toIsoDate } from "../lib/format-date";
import { changelogCategoryTone, changelogRollup, firstChangelogEntries, newestReleaseWithAssets, sortReleasesNewestFirst } from "../lib/releases";

type ReleaseEntry = CollectionEntry<"releases">;
type ReleaseAsset = ReleaseEntry["data"]["assets"][number];

const releases: ReleaseEntry[] = sortReleasesNewestFirst(await getCollection("releases"));
const latestRelease = releases[0];
const latestWithAssets = newestReleaseWithAssets(releases);
const dockerFull = `docker run --rm \\
  -p 4566:4566 \\
  -p 4567:4567 \\
  ghcr.io/overcast-sh/overcast:latest`;
const dockerSlim = `docker run --rm \\
  -p 4566:4566 \\
  ghcr.io/overcast-sh/overcast-slim:latest`;
const assets: ReleaseAsset[] = latestWithAssets?.data.assets || [];
const releasesUrl = latestWithAssets?.data.url || `${repositoryUrl()}/releases`;
const latestReleaseDate = formatDate(latestRelease?.data.publishedAt);
const assetsReleaseDate = formatDate(latestWithAssets?.data.publishedAt);
const topChangelogEntries = latestRelease ? firstChangelogEntries(latestRelease.data.changelogSections, 3) : [];
const topRollup = latestRelease ? changelogRollup(latestRelease.data.changelogSections) : null;
---

<SiteLayout title="Downloads" description="Install Overcast with one line, or pull the Docker images and native binaries." searchTitle="Downloads">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><Download class="icon" />downloads</p>
    <h1 class="mt-2 font-mono text-3xl font-bold">One line installs it. Docker images and binaries are below.</h1>
    <p class="mt-4 max-w-3xl leading-7 text-body">
      The installer picks the binary for your OS and CPU, checks it against the release's <code>SHA256SUMS</code>,
      and puts it in a directory of your own. It never asks a question and never uses <code>sudo</code>.
    </p>
    <div class="mt-6 max-w-3xl">
      <InstallTabs id="downloads" />
    </div>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-muted">
      <code>--slim</code> installs the headless <code>overcastd</code>, <code>--version</code> pins a release, and
      <code>irm | iex</code> takes the same choices as environment variables. Every flag is on the
      <a href="/docs/install/">install page</a>; the scripts are readable at
      <a href={`${repositoryUrl()}/blob/main/install/install.sh`}>install.sh</a> and
      <a href={`${repositoryUrl()}/blob/main/install/install.ps1`}>install.ps1</a>.
    </p>
    <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
      <a class="copy-button inline-flex items-center gap-2 rounded-md px-3 py-2 font-mono text-sm no-underline" href="/releases/">
        <RotateCcwClock class="icon" />Older versions
      </a>
      <a class="copy-button inline-flex items-center gap-2 rounded-md px-3 py-2 font-mono text-sm no-underline" href={releasesUrl}>
        <FileText class="icon" />GitHub releases
      </a>
      <a class="copy-button inline-flex items-center gap-2 rounded-md px-3 py-2 font-mono text-sm no-underline" href="/console/">
        <Monitor class="icon" />What's in the console
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8">
    <h2 class="flex items-center gap-2 font-mono text-lg font-bold"><Container class="icon" />Docker images</h2>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-body">
      The full image serves the AWS-compatible API on port <code>4566</code> and the web console on port
      <code>4567</code>. The slim image is the emulator alone, for headless CI and local service tests.
    </p>
  </section>

  <section class="mx-auto grid max-w-7xl gap-6 px-4 pb-10 sm:px-6 sm:pb-14 lg:grid-cols-2 lg:px-8">
    <div class="min-w-0">
      <div class="mb-3 flex items-center gap-2 font-mono text-sm"><span class="icon-tile"><Container class="icon" /></span>Full image</div>
      <CodeBlock code={dockerFull} label="full image with web UI" language="bash" />
    </div>
    <div class="min-w-0">
      <div class="mb-3 flex items-center gap-2 font-mono text-sm"><span class="icon-tile"><Binary class="icon" /></span>Slim image</div>
      <CodeBlock code={dockerSlim} label="slim CI image" language="bash" />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 sm:pb-14 lg:px-8">
    <div class="surface overflow-hidden rounded-lg">
      <div class="border-b border-oc p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="flex items-center gap-2 font-mono text-lg font-bold"><PackageOpen class="icon" />Native binaries</h2>
          <a class="inline-flex items-center gap-2 font-mono text-xs" href="/releases/">
            <RotateCcwClock class="icon" />Older versions
          </a>
        </div>
        <p class="mt-2 text-sm text-muted">
          {latestWithAssets && (
            <>
              Showing assets from <a href={latestWithAssets.data.url}>{latestWithAssets.data.name}</a>
              {assetsReleaseDate && <> published <time datetime={toIsoDate(latestWithAssets.data.publishedAt)} title={formatDateTimeTitle(latestWithAssets.data.publishedAt)}>{assetsReleaseDate}</time></>}.
            </>
          )}
        </p>
      </div>
      {assets.length > 0 ? (
        <AssetDownloadList assets={assets} />
      ) : (
        <div class="px-5 py-10 text-sm text-body">
          Native binary links could not be loaded for this build. Use the
          <a href={releasesUrl}> GitHub releases page</a> for the latest assets.
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 sm:pb-14 lg:px-8">
    <div class="surface rounded-lg p-5">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-oc pb-5">
        <div>
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted">
            <FileText class="icon" />latest changelog
          </p>
          <h2 class="mt-2 font-mono text-xl font-bold">{latestRelease?.data.name || "Latest release"}</h2>
          {latestReleaseDate && (
            <p class="mt-2 text-sm text-muted">
              Published <time datetime={toIsoDate(latestRelease?.data.publishedAt)} title={formatDateTimeTitle(latestRelease?.data.publishedAt)}>{latestReleaseDate}</time>
            </p>
          )}
        </div>
        {latestRelease && (
          <a class="copy-button inline-flex items-center gap-2 rounded-md px-3 py-2 font-mono text-xs no-underline" href={latestRelease.data.url}>
            View on GitHub
          </a>
        )}
      </div>
      {latestRelease && topChangelogEntries.length > 0 ? (
        <>
          {topRollup && (
            <p class="mt-5 font-mono text-xs text-muted">
              {topRollup.counts.map((count, index) => (
                <>
                  {index > 0 && " · "}
                  {`${count.count} ${count.label.toLowerCase()}`}
                </>
              ))}
              {topRollup.breakingCount > 0 && (
                <>
                  {" "}
                  · <span class="text-(--oc-danger)">{topRollup.breakingCount} breaking</span>
                </>
              )}
            </p>
          )}
          <div class="mt-3 space-y-3">
            {topChangelogEntries.map((entry) => (
              <div class="border-b border-oc pb-3 last:border-0 last:pb-0">
                <div class="flex flex-wrap items-center gap-1.5">
                  <Chip tone={changelogCategoryTone[entry.category]}>{entry.label}</Chip>
                  {entry.breaking && <Chip tone="danger">Breaking</Chip>}
                  {entry.areas.map((area) => (
                    <Chip tone="muted">{area}</Chip>
                  ))}
                </div>
                {/* The same component /releases/ renders each entry with, so the card's wording,
                    its inline code and its disclosure rules match the full changelog exactly —
                    the card just shows fewer entries, and folds every detail line away. Rendering
                    the summary as HTML is also what keeps `LAMBDA_RUNTIME_API_HOST` intact: the
                    old plain-text path stripped the underscores out of every env var and
                    `/_overcast/...` path it printed. */}
                <ChangelogEntryBody
                  class="mt-2 text-sm leading-6 text-body"
                  summaryHtml={entry.summaryHtml}
                  detailsHtml={entry.detailsHtml}
                  migrationHtml={entry.migrationHtml}
                  inlineDetailLimit={0}
                />
              </div>
            ))}
          </div>
          <a class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs" href="/releases/">
            Full changelog<ArrowRight class="icon" />
          </a>
        </>
      ) : latestRelease && latestRelease.data.summary ? (
        <>
          <p class="mt-5 text-sm leading-6 text-body">{latestRelease.data.summary}</p>
          <a class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs" href="/releases/">
            Full changelog<ArrowRight class="icon" />
          </a>
        </>
      ) : (
        <p class="mt-5 text-sm leading-6 text-body">
          GitHub release notes could not be loaded for this build. Check the
          <a href={`${repositoryUrl()}/releases`}> GitHub releases page</a> for the latest changelog.
        </p>
      )}
    </div>
  </section>
</SiteLayout>
