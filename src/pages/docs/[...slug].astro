---
import SiteLayout from "../../components/SiteLayout.astro";
import { ChevronDown } from "@lucide/astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { overcastEditUrl } from "../../lib/github-links";
import { getServiceSupport } from "../../lib/generated-content";

type DocEntry = CollectionEntry<"docs">;

export async function getStaticPaths() {
  // No synced doc maps to the bare "docs" slug (docs/README.md now lives at
  // "docs/reference" — see overcast-docs.ts) — /docs/ itself is a separate, hand-authored
  // page at src/pages/docs/index.astro, so every entry here safely strips the "docs/" prefix.
  const docs: DocEntry[] = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.data.slug.replace(/^docs\//, "") },
    props: { doc },
  }));
}

const { doc } = Astro.props as { doc: DocEntry };
const docs: DocEntry[] = await getCollection("docs");
// The page chrome below already renders doc.data.title as an <h1>. Every synced doc's
// markdown body opens with the same title repeated as its own leading "# ..." heading
// (a structural convention upstream, not a one-off), so strip only that leading <h1> —
// pure duplication — and leave the rest of the body untouched.
const html = (doc.rendered?.html ?? "").replace(/^\s*<h1[^>]*>[\s\S]*?<\/h1>\s*/i, "");
const editUrl = await overcastEditUrl(doc.data.sourcePath);
const grouped = Object.entries(
  docs.reduce<Record<string, DocEntry[]>>((groups, entry) => {
    groups[entry.data.section] ??= [];
    groups[entry.data.section].push(entry);
    return groups;
  }, {}),
);

// The "Service Reference" section is a flat, alphabetical list of ~50 doc pages — the same
// coverage-tier grouping already shown on the homepage's "top services" tiles and in the
// upstream service table (Comprehensive / Core CRUD / Minimal / IaC-stub) turns that into
// four labeled clusters instead of one long scroll. coverageTier comes from parsing
// docs/README.md's generated service table at sync time (see sync-overcast-content.ts);
// a doc with no match (e.g. the services index page itself) falls into "Other".
const tierOrder = [
  "Comprehensive / broad support",
  "Core CRUD + common workflows",
  "Minimal / targeted support",
  "IaC/discovery-oriented stub",
];
const support = await getServiceSupport();
const tierForDoc = (entry: DocEntry): string => {
  const docSlug = entry.data.slug.split("/").pop();
  const service = support.services.find((s) => s.docSlug === docSlug);
  return service?.coverageTier || "Other";
};
const servicesByTier = (entries: DocEntry[]): Array<[string, DocEntry[]]> => {
  const buckets = new Map<string, DocEntry[]>();
  for (const entry of entries) {
    const tier = tierForDoc(entry);
    buckets.set(tier, [...(buckets.get(tier) ?? []), entry]);
  }
  return [...tierOrder, "Other"].filter((tier) => buckets.has(tier)).map((tier) => [tier, buckets.get(tier)!]);
};
---

<SiteLayout title={doc.data.title} description={doc.data.description} editUrl={editUrl}>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[260px_1fr] lg:px-8">
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-auto">
      <a class="mb-4 hidden font-mono text-sm font-bold lg:block" href="/docs/">Documentation</a>

      <details class="group sticky top-[4.75rem] z-10 mb-4 lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-oc bg-card px-3 py-3 font-mono text-sm font-semibold text-(--oc-text) shadow-sm [&::-webkit-details-marker]:hidden">
          Docs navigation
          <ChevronDown class="icon shrink-0 text-muted transition-transform duration-150 group-open:rotate-180" />
        </summary>
        <div class="mt-2 max-h-[60vh] overflow-auto rounded-md border border-oc bg-card p-3">
          {grouped.map(([section, entries]) => (
            <div class="mb-5 last:mb-0">
              <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{section}</h2>
              {section === "Service Reference" ? (
                servicesByTier(entries).map(([tier, tierEntries]) => (
                  <div class="mb-3 last:mb-0">
                    <p class="mb-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted opacity-75">{tier}</p>
                    <nav class="space-y-1">
                      {tierEntries.map((entry) => (
                        <a
                          class={`block rounded-md px-3 py-3 text-sm no-underline ${entry.data.slug === doc.data.slug ? "soft text-(--oc-text)" : "text-muted"}`}
                          href={`/${entry.data.slug}/`}
                        >
                          {entry.data.title}
                        </a>
                      ))}
                    </nav>
                  </div>
                ))
              ) : (
                <nav class="space-y-1">
                  {entries?.map((entry) => (
                    <a
                      class={`block rounded-md px-3 py-3 text-sm no-underline ${entry.data.slug === doc.data.slug ? "soft text-(--oc-text)" : "text-muted"}`}
                      href={`/${entry.data.slug}/`}
                    >
                      {entry.data.title}
                    </a>
                  ))}
                </nav>
              )}
            </div>
          ))}
        </div>
      </details>

      <div class="hidden lg:block">
        {grouped.map(([section, entries]) => (
          <div class="mb-5">
            <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{section}</h2>
            {section === "Service Reference" ? (
              servicesByTier(entries).map(([tier, tierEntries]) => (
                <div class="mb-3 last:mb-0">
                  <p class="mb-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted opacity-75">{tier}</p>
                  <nav class="space-y-1">
                    {tierEntries.map((entry) => (
                      <a
                        class={`block rounded-md px-2 py-1.5 text-sm no-underline ${entry.data.slug === doc.data.slug ? "soft text-(--oc-text)" : "text-muted"}`}
                        href={`/${entry.data.slug}/`}
                      >
                        {entry.data.title}
                      </a>
                    ))}
                  </nav>
                </div>
              ))
            ) : (
              <nav class="space-y-1">
                {entries?.map((entry) => (
                  <a
                    class={`block rounded-md px-2 py-1.5 text-sm no-underline ${entry.data.slug === doc.data.slug ? "soft text-(--oc-text)" : "text-muted"}`}
                    href={`/${entry.data.slug}/`}
                  >
                    {entry.data.title}
                  </a>
                ))}
              </nav>
            )}
          </div>
        ))}
      </div>
    </aside>
    <article class="min-w-0">
      <div class="mb-8 border-b border-oc pb-6">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">{doc.data.section}</p>
        <h1 class="mt-2 font-mono text-3xl font-bold">{doc.data.title}</h1>
        {doc.data.description && <p class="mt-3 max-w-3xl text-body">{doc.data.description}</p>}
      </div>
      <div class="prose" set:html={html} data-pagefind-body></div>
    </article>
  </div>
</SiteLayout>
