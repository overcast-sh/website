---
import SiteLayout from "../../components/SiteLayout.astro";
import DocsNav from "../../components/DocsNav.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import ServiceSubNav from "../../components/ServiceSubNav.astro";
import { ChevronDown } from "@lucide/astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { overcastEditUrl } from "../../lib/github-links";
import { getServiceSupport } from "../../lib/generated-content";
import { groupServiceDocs, parseServiceDocSlug, serviceNavItems } from "../../lib/service-docs";

type DocEntry = CollectionEntry<"docs">;

export async function getStaticPaths() {
  // No synced doc maps to the bare "docs" slug (docs/README.md now lives at
  // "docs/reference" — see overcast-docs.ts) — /docs/ itself is a separate, hand-authored
  // page at src/pages/docs/index.astro, so every entry here safely strips the "docs/" prefix.
  // Nested service pages keep their slashes: "docs/services/s3/operations" becomes the rest
  // param "services/s3/operations", i.e. /docs/services/s3/operations/.
  const docs: DocEntry[] = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.data.slug.replace(/^docs\//, "") },
    props: { doc },
  }));
}

const { doc } = Astro.props as { doc: DocEntry };
const docs: DocEntry[] = await getCollection("docs");
// The page chrome below already renders doc.data.title as an <h1>. Every synced doc's
// markdown body opens with the same title repeated as its own leading "# ..." heading
// (a structural convention upstream, not a one-off), so strip only that leading <h1> —
// pure duplication — and leave the rest of the body untouched.
//
// A leading HTML comment counts as "leading" too: every generated `operations.md` opens
// `<!-- BEGIN overcast:capabilities -->` above its `# ...`, so the strip missed the
// heading on all fifty of them and each page carried two <h1>s, its own title twice.
const body = (doc.rendered?.html ?? "").replace(/^\s*(?:<!--[\s\S]*?-->\s*)*<h1[^>]*>[\s\S]*?<\/h1>\s*/i, "");

// The same convention repeats the lead: the paragraph after that "# ..." heading is what
// the frontmatter description was written from, so the page printed the sentence twice —
// once as the subtitle under the title, then again as the body's first paragraph. The
// subtitle is the worse of the two copies, because `description` is capped at 220
// characters upstream and arrives truncated mid-clause. So when the body's opening
// paragraph starts with the description, the paragraph wins: it becomes the subtitle
// (keeping its inline code spans) and is dropped from the body.
const plain = (value: string) => value.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const comparable = (value: string) => plain(value).toLowerCase().replace(/[…\s.]+$/, "");
const leadMatch = body.match(/^\s*<p>([\s\S]*?)<\/p>\s*/i);
const describedLead = comparable(doc.data.description ?? "");
// An exact match is a duplicate at any length ("EKS supports two modes:" is 23
// characters and repeated verbatim). Short of that, require 40 characters of shared
// prefix — enough that a coincidental match isn't plausible, and below it the two are
// too terse to confidently call the same sentence, so the page keeps both.
const leadPlain = leadMatch ? comparable(leadMatch[1]) : "";
const leadIsDescription =
  Boolean(leadMatch) &&
  describedLead.length > 0 &&
  (leadPlain === describedLead || (describedLead.length >= 40 && leadPlain.startsWith(describedLead.slice(0, 60))));
const html = leadIsDescription ? body.slice(leadMatch![0].length) : body;
const leadHtml = leadIsDescription ? leadMatch![1] : null;
// Cross-references in the source markdown are written as repo paths — "see
// networking.md § How Overcast decides who owns a Host". The href is already
// rewritten to the published route, but the visible text still reads as a filename
// on 40-odd pages, which is a link to a file the reader can't open and a page they
// can. Swap the filename for the page's own title, keeping any "§ Heading" suffix.
// Inert once the source stops naming files: nothing matches and nothing changes.
const titleByRoute = new Map<string, string>(docs.map((entry) => [`/${entry.data.slug}/`, entry.data.title]));
const withNamedLinks = html.replace(
  /(<a href="(\/docs\/[^"#]*\/)(?:#[^"]*)?"[^>]*>)([A-Za-z0-9._-]+\.md)(?=(\s*§[^<]*)?<\/a>)/g,
  (_match: string, open: string, route: string, filename: string) => `${open}${titleByRoute.get(route) ?? filename}`,
);
const editUrl = await overcastEditUrl(doc.data.sourcePath);
const support = await getServiceSupport();
const navDocs = docs.map((entry) => ({ slug: entry.data.slug, title: entry.data.title, section: entry.data.section }));

// Service pages get their own header: the service's icon and identity colour, a breadcrumb
// back up the tree, and — once a service has sub-pages — a page switcher. Everything else
// keeps the plain section eyebrow.
const serviceDoc = parseServiceDocSlug(doc.data.slug);
const serviceGroup = serviceDoc ? groupServiceDocs(navDocs).get(serviceDoc.service) : undefined;
const subNavItems = serviceNavItems(serviceGroup);
// The support data's service id and the doc's filename differ for a couple of services
// (`elbv2` vs docs/services/elb.md), and the icon table is keyed by the former.
const serviceMeta = serviceDoc ? support.services.find((s) => s.docSlug === serviceDoc.service) : undefined;
const serviceId = serviceMeta?.service ?? serviceDoc?.service ?? "";
const serviceName = serviceMeta?.displayName ?? serviceGroup?.landing?.title.split(/\s+[—–-]\s+/)[0] ?? serviceDoc?.service.toUpperCase() ?? "";
const serviceLandingSlug = serviceGroup?.landing?.slug;
---

<SiteLayout title={doc.data.title} description={doc.data.description} editUrl={editUrl}>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 sm:py-14 lg:grid-cols-[260px_1fr] lg:px-8">
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100vh-6rem)] lg:overflow-auto">
      <a class="mb-4 hidden font-mono text-sm font-bold lg:block" href="/docs/">Documentation</a>

      <details class="group sticky top-[4.75rem] z-10 mb-4 lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-oc bg-card px-3 py-3 font-mono text-sm font-semibold text-(--oc-text) shadow-sm [&::-webkit-details-marker]:hidden">
          Docs navigation
          <ChevronDown class="icon shrink-0 text-muted transition-transform duration-150 group-open:rotate-180" />
        </summary>
        <nav class="mt-2 max-h-[60vh] overflow-auto rounded-md border border-oc bg-card p-3" aria-label="Documentation">
          <DocsNav docs={navDocs} currentSlug={doc.data.slug} support={support} idPrefix="docsnav-drawer" compact />
        </nav>
      </details>

      <nav class="hidden lg:block" aria-label="Documentation">
        <DocsNav docs={navDocs} currentSlug={doc.data.slug} support={support} idPrefix="docsnav-side" />
      </nav>
    </aside>
    <article class="min-w-0">
      <div class="mb-8 border-b border-oc pb-8">
        {serviceDoc ? (
          <nav class="flex flex-wrap items-center gap-1.5 font-mono text-xs uppercase tracking-[0.16em] text-muted" aria-label="Breadcrumb">
            <a class="no-underline text-muted hover:text-(--oc-text)" href="/docs/">Docs</a>
            <span aria-hidden="true">›</span>
            <a class="no-underline text-muted hover:text-(--oc-text)" href="/docs/services/">Services</a>
            <span aria-hidden="true">›</span>
            {serviceDoc.page && serviceLandingSlug ? (
              <a class="no-underline text-muted hover:text-(--oc-text)" href={`/${serviceLandingSlug}/`}>{serviceName}</a>
            ) : (
              <span class="text-(--oc-text)">{serviceName}</span>
            )}
          </nav>
        ) : (
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted">{doc.data.section}</p>
        )}
        <div class="mt-2 flex items-center gap-3">
          {serviceDoc && <ServiceIcon service={serviceId} />}
          <h1 class="min-w-0 font-mono text-3xl font-bold">{doc.data.title}</h1>
        </div>
        {leadHtml ? (
          <p class="mt-4 max-w-3xl text-body" set:html={leadHtml}></p>
        ) : (
          doc.data.description && <p class="mt-4 max-w-3xl text-body">{doc.data.description}</p>
        )}
        <ServiceSubNav items={subNavItems} currentSlug={doc.data.slug} />
      </div>
      <div class="prose" set:html={withNamedLinks} data-pagefind-body></div>
    </article>
  </div>
</SiteLayout>
