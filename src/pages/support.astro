---
import SiteLayout from "../components/SiteLayout.astro";
import { ShieldCheck } from "@lucide/astro";
import { getServiceSupport } from "../lib/generated-content";

const support = await getServiceSupport();
const services = support.services.slice().sort((a, b) => a.displayName.localeCompare(b.displayName));
---

<SiteLayout title="Support Matrix" description="Overcast service and operation implementation status.">
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-muted"><ShieldCheck class="icon" />support matrix</p>
    <h1 class="mt-2 font-mono text-3xl font-bold">Listed service operations, with visible gaps.</h1>
    <p class="mt-4 max-w-3xl leading-7 text-body">
      This matrix reports which listed API operations are implemented in the current Overcast source. It is not a claim
      of complete AWS compatibility; alpha behavior still needs broad real-world use. Unsupported operations return
      clear <code>501 Not Implemented</code> responses.
    </p>
    <div class="mt-8 surface overflow-hidden rounded-lg">
      <div class="grid grid-cols-[1fr_100px_120px] gap-3 border-b border-oc px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
        <span>service</span>
        <span class="text-right">listed ops</span>
        <span class="text-right">implemented</span>
      </div>
      {services.map((service) => (
        <a class="grid grid-cols-[1fr_100px_120px] gap-3 border-b border-oc px-4 py-3 text-sm no-underline last:border-b-0" href={`/docs/services/${service.service}/`}>
          <span class="font-mono text-(--oc-text)">{service.displayName}</span>
          <span class="text-right text-muted">{service.totalOps}</span>
          <span class="text-right font-mono text-accent">{service.implementedOps}</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
